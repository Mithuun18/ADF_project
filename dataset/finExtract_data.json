		},
		"parameters": {
			"ex_filename": {
				"type": "string"
			},
			"ex_filesystem": {
				"type": "string",
				"defaultValue": "pocprj"
			},
			"ex_directory": {
				"type": "string",
				"defaultValue": "extracted"
			}
		},
		"annotations": [],
